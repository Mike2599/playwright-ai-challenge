# ─────────────────────────────────────────────────────────────────────────────
#  Configuración de ejecución. Copia este archivo:  cp .env.example .env
#  .env NO se versiona (está en .gitignore). Nunca subas claves reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proveedor de IA ──────────────────────────────────────────────────────────
# openai | anthropic | ollama
AI_PROVIDER=openai
# Clave del proveedor. Obligatoria para openai y anthropic; se ignora con ollama.
AI_API_KEY=tu_api_key_aqui
# Modelo. Si se deja vacío se usa el de cada proveedor:
#   openai → gpt-4o-mini · anthropic → claude-haiku-5-5 · ollama → llama3.1:8b
AI_MODEL=gpt-4o-mini
# (Opcional) URL base de la API. Útil para Ollama en otra máquina o un proxy compatible con OpenAI.
#   ollama → http://localhost:11434 · openai → https://api.openai.com/v1 · anthropic → https://api.anthropic.com
AI_BASE_URL=
# (Opcional) Tiempo máximo por llamada a la IA en ms. Súbelo si el modelo local corre en CPU.
AI_TIMEOUT_MS=120000
# (Opcional) Reintentos ante errores de red, 429 o 5xx del proveedor.
AI_MAX_RETRIES=2

# ── Aplicación bajo prueba ──────────────────────────────────────────────────
BASE_URL=https://www.saucedemo.com
# Credenciales públicas de demostración que SauceDemo muestra en su página de login.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# ── Retos de IA ─────────────────────────────────────────────────────────────
# Opción A: cuánto espera el localizador original antes de pedir ayuda a la IA (ms).
SELF_HEALING_TIMEOUT_MS=3000
# Opción B: confianza mínima (0 a 1) que debe reportar la IA para aprobar una aserción semántica.
SEMANTIC_CONFIDENCE_THRESHOLD=0.7

# ── Entorno de ejecución ────────────────────────────────────────────────────
# local | ci  → carga environments/<TEST_ENV>.env (workers, reintentos, navegadores).
TEST_ENV=local
# (Opcional) Sobrescriben lo que define el entorno:
# BROWSERS=chromium,firefox,webkit
# WORKERS=1
# RETRIES=0
# HEADLESS=true
# Tiempo máximo por prueba en ms (las pruebas con IA local en CPU pueden tardar varios minutos).
TEST_TIMEOUT_MS=600000
